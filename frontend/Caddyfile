{$DOMAIN:localhost} {
	encode gzip
	root * /srv

	@django path /api/* /club-admin /club-admin/* /static/*
	handle @django {
		reverse_proxy django:8000
	}

	# 해시된 빌드 파일: 오래 캐시. 없는 파일은 index.html이 아니라 404 (캐시 헤더 없이).
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 나머지(index.html로 떨어지는 SPA 경로 포함): 매번 재검증해 재배포 후 새 index.html을 받는다.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
