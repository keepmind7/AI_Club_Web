# 관리자 화면에 보이는 Django 기본 번역 중 어색하거나 틀린 것만 바꾼다.
# 여기 없는 문구는 Django 번역을 그대로 쓴다. 회원 앱과 같은 말투(해요체)로, '을/를' 같은 겹조사 없이.
# 고친 뒤에는 이 폴더에서 `msgfmt -o django.mo django.po`로 django.mo를 다시 만들어 함께 커밋한다
# (Docker 이미지에는 gettext가 없어서 .mo를 저장소에 둔다).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ko\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# --- 삭제 확인 (팝업) ---
msgid "Delete multiple objects"
msgstr "삭제 확인"

#, python-format
msgid "Cannot delete %(name)s"
msgstr "삭제할 수 없어요"

#, python-format
msgid ""
"Are you sure you want to delete the selected %(objects_name)s? All of the "
"following objects and their related items will be deleted:"
msgstr "선택한 %(objects_name)s 삭제할까요? 아래 항목이 함께 지워지고, 되돌릴 수 없어요."

#, python-format
msgid ""
"Are you sure you want to delete the %(object_name)s \"%(escaped_object)s\"? "
"All of the following related items will be deleted:"
msgstr "“%(escaped_object)s” 삭제할까요? 아래 항목이 함께 지워지고, 되돌릴 수 없어요."

#, python-format
msgid ""
"Deleting the selected %(objects_name)s would require deleting the following "
"protected related objects:"
msgstr "아래 항목이 연결돼 있어 삭제할 수 없어요. 이 항목을 먼저 정리해 주세요."

#, python-format
msgid ""
"Deleting the %(object_name)s '%(escaped_object)s' would require deleting the "
"following protected related objects:"
msgstr "아래 항목이 연결돼 있어 삭제할 수 없어요. 이 항목을 먼저 정리해 주세요."

#, python-format
msgid ""
"Deleting the selected %(objects_name)s would result in deleting related "
"objects, but your account doesn't have permission to delete the following "
"types of objects:"
msgstr "함께 지워야 하는 항목 중 삭제 권한이 없는 것이 있어 삭제할 수 없어요."

#, python-format
msgid ""
"Deleting the %(object_name)s '%(escaped_object)s' would result in deleting "
"related objects, but your account doesn't have permission to delete the "
"following types of objects:"
msgstr "함께 지워야 하는 항목 중 삭제 권한이 없는 것이 있어 삭제할 수 없어요."

#, python-format
msgid ""
"Deleting %(class_name)s %(instance)s would require deleting the following "
"protected related objects: %(related_objects)s"
msgstr "%(instance)s에 연결된 항목이 있어 삭제할 수 없어요: %(related_objects)s"

msgid "Summary"
msgstr "개수"

msgid "Objects"
msgstr "지워지는 항목"

msgid "Yes, I’m sure"
msgstr "삭제"

msgid "No, take me back"
msgstr "취소"

# --- 저장·삭제 뒤 안내 ---
#, python-format
msgid "Successfully deleted %(count)d %(items)s."
msgstr "선택한 %(count)d개를 삭제했어요."

#, python-format
msgid "The %(name)s “%(obj)s” was deleted successfully."
msgstr "“%(obj)s” 삭제했어요."

#, python-brace-format
msgid "The {name} “{obj}” was added successfully."
msgstr "“{obj}” 추가했어요."

#, python-brace-format
msgid "The {name} “{obj}” was changed successfully."
msgstr "“{obj}” 저장했어요."

#, python-brace-format
msgid ""
"The {name} “{obj}” was changed successfully. You may edit it again below."
msgstr "“{obj}” 저장했어요."

#, python-brace-format
msgid ""
"The {name} “{obj}” was added successfully. You may add another {name} below."
msgstr "“{obj}” 추가했어요. 이어서 하나 더 넣을 수 있어요."

#, python-brace-format
msgid ""
"The {name} “{obj}” was changed successfully. You may add another {name} "
"below."
msgstr "“{obj}” 저장했어요. 이어서 하나 더 넣을 수 있어요."

msgid "You may edit it again below."
msgstr "이어서 고칠 수 있어요."

#, python-format
msgid "%(count)s %(name)s was changed successfully."
msgid_plural "%(count)s %(name)s were changed successfully."
msgstr[0] "%(count)s개를 저장했어요."

msgid ""
"Items must be selected in order to perform actions on them. No items have "
"been changed."
msgstr "먼저 항목을 체크해 주세요. 아무것도 바뀌지 않았어요."

msgid "No action selected."
msgstr "작업을 고르지 않았어요."

msgid "Please correct the error below."
msgid_plural "Please correct the errors below."
msgstr[0] "아래 오류를 고쳐 주세요."

# --- 목록·기록 ---
#, python-format
msgid "%(counter)s result"
msgid_plural "%(counter)s results"
msgstr[0] "%(counter)s개"

#, python-format
msgid "%(full_result_count)s total"
msgstr "전체 %(full_result_count)s개"

#, python-format
msgid "Select %s to change"
msgstr "%s"

#, python-format
msgid "Select all %(total_count)s %(module_name)s"
msgstr "%(module_name)s %(total_count)s개 모두 선택"

msgid "History"
msgstr "변경 기록"

#, python-format
msgid "Change history: %s"
msgstr "변경 기록: %s"

msgid ""
"This object doesn’t have a change history. It probably wasn’t added via this "
"admin site."
msgstr "변경 기록이 없어요. 관리자 화면 밖에서 만든 항목이에요."

msgid "None available"
msgstr "없어요."

# --- 비밀번호 초기화 (django.contrib.auth) ---
msgid "Password changed successfully."
msgstr "비밀번호를 바꿨어요."
