# 복사해서 .env로 저장하고 값을 채운다. .env는 Git에 올리지 않는다.

# 접속 도메인. Caddy가 이 이름으로 HTTPS 인증서를 받는다.
DOMAIN=myclub.duckdns.org
# Django 비밀 키. 비워 두면 django가 시작하지 않는다. 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Django가 받을 호스트 이름 (쉼표로 구분). 보통 DOMAIN과 같다.
ALLOWED_HOSTS=myclub.duckdns.org
# POST 요청을 허용할 출처 (https:// 포함, 쉼표로 구분).
CSRF_TRUSTED_ORIGINS=https://myclub.duckdns.org
# DEBUG(운영은 0으로 고정)와 DB_PATH(/app/data/db.sqlite3)는 docker-compose.yml에서 정한다.
